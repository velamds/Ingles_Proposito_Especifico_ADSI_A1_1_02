type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}], "questions": [{"_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}], "responses": [{"_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 0, "id": 0}, {"_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 1, "id": 1}], "id": 0}], "type": "RSLT", "template_override": 1, "id": 10}, {"stimuli_ids": [], "_data": [{"contents": [{"type": "text", "content": " Let's think about business processes"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "", "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}], "questions": [{"_data": [{"contents": [{"type": "pdf", "content": "enpe8n1le02ob07re7pdf01.pdf"}], "type": "question"}], "responses": [{"_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 1, "id": 0}], "id": 0}], "type": "DWS", "template_override": 1, "id": 11}], "stimuli": [{"template_override": 1, "id": 0, "_data": [], "contents": [{}], "type": "welcome"}, {"_data": [], "contents": [{"value": {"audiosrc": "enpe8n1le02ob07re2aud01", "images": [{"time": "0", "image": "enpe8n1le02ob07re2img01.jpg", "id": 0, "text": "<span class=\"strong\">Andrea</span>: Hello Jefferson.</br>\n<span class=\"strong\">Jefferson</span>: Hi Andrea. I am calling you because I want to understand the importance of a business process diagram.</br>\n<span class=\"strong\">Andrea</span>: Absolutely. As you know, businesses have goals. These goals include a series of activities or tasks. Each activity appears in order of execution. Here the manager knows which activities go first. So, organizing a diagram increases productivity and cuts costs. It arranges a process and specifies possible situations and outcomes. It helps the business to improve and implement changes."}, {"time": "33000", "image": "enpe8n1le02ob07re2img02.jpg", "id": 1, "text": "<span class=\"strong\">Jefferson</span>: Does the business process diagram include all the different parts involved in a business?</br>\n<span class=\"strong\">Andrea</span>: Yes, in a diagram you put activities next to the areas that are in charge of them. Then you draw lines that connect the activities with processes. Between each activity, most of the times there is a Yes or No in order to know what to do if an outcome or failure is present.  This diagram helps your business to look at the big picture and consider all possible scenarios.</br>\n<span class=\"strong\">Jefferson</span>: And after you draw the diagram, what happens?"}, {"time": "66000", "image": "enpe8n1le02ob07re2img03.jpg", "id": 2, "text": "<span class=\"strong\">Andrea</span>: Well, another positive outcome of the business process diagram is that it can create a visual aid that everyone can see, discuss and agree on. It can help you decrease upfront errors and prevent unnecessary changes during production or selling.</br>\n<span class=\"strong\">Jefferson</span>: What are the elements of a business process diagram?</br>\n<span class=\"strong\">Andrea</span>: There are four basic components of a business process diagram. First, the flow objects. Flow objects represent events, activities, and gateways or paths. Second, the connecting objects. Connecting objects represent associations and participants in a process. Third, the swim lanes. The swim lanes contain lanes, like a real swimming pool. And, fourth, the artifacts. Artifacts show the reader the requirements and productivity in an activity. Among these parts of the diagram, you can develop actions and processes.</br>\n<span class=\"strong\">Jefferson</span>: Thank you, now I understand."}], "coverimg": "enpe8n1le02ob07re2img01.jpg"}, "type": "slideshow"}], "type": "audio", "template_override": 1, "id": 1, "title": ""}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "type": "scholar"}]}